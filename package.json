{
  "name": "github-review-queue-mcp",
  "version": "0.1.0",
  "description": "MCP server for your GitHub review queue: find PRs waiting on you, read them, check CI, comment and review. Runs locally over stdio, or as a remote server with OAuth 2.1 (PKCE, DCR, consent, token rotation).",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "github",
    "pull-requests",
    "code-review",
    "oauth",
    "claude",
    "chatgpt"
  ],
  "author": "Alijah Konikowski",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alijahak/github-review-queue-mcp.git"
  },
  "type": "module",
  "bin": {
    "github-review-queue-mcp": "dist/stdio.js",
    "github-review-queue-mcp-http": "dist/http/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "readiness": "npm run build && mcp-readiness --env GITHUB_TOKEN=unused -- node dist/stdio.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "mcp-readiness": "github:alijahak/mcp-readiness",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
